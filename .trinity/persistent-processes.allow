# Trinity orphan-sweep allowlist (cmdline globs, one per line; Abilityai/cornelius#17).
# Read by the agent server from ~/.trinity/persistent-processes.allow and matched
# with fnmatch.fnmatchcase against the full argv joined by spaces; a match
# protects the pid AND its descendant tree. Without this file the periodic sweep
# kills every process that is not part of a running execution.

# Local Brain Search daemon (resources/local-brain-search/daemon.py, port 7437).
# run_daemon.sh starts it detached, so it reparents to PID 1 and outlives the
# execution that started it.
*/local-brain-search/venv/bin/python */local-brain-search/daemon.py*

# run_daemon.sh `ensure` worker: a short-lived bash that (re)starts the daemon and
# drops .daemon-ensure.lock. If swept mid-start the lock would block restarts for
# 3 minutes. Exits on its own once the daemon answers.
bash -c *local-brain-search/.daemon-ensure.lock*

# First-boot bootstrap (.trinity/bootstrap.sh, launched detached by setup.sh until
# ~/.trinity-bootstrap.done exists). Its pip install and reindex run as its
# descendants and take minutes; without this line the sweep kills them mid-way.
# It exits by itself when done.
bash */.trinity/bootstrap.sh*
